# All tokens below are optional — filesystem, git, and shell tools work
# with no configuration at all. Add only the ones you need.
#
# Easiest way to fill this in: run `npm run setup` instead of editing by hand.

# GitHub — repo/issue/PR tools
# Create at: https://github.com/settings/tokens?type=beta
# Needs: Contents (read/write), Issues (read/write), Pull requests (read/write),
# Administration (read/write, only if you want github_create_repo / github_delete_repo)
GITHUB_TOKEN=

# Vercel — project/deployment tools
# Create at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Supabase — project/SQL tools
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Slack — channel/message tools
# Create a Slack app at: https://api.slack.com/apps -> OAuth & Permissions
# Bot token scopes needed: channels:read, channels:history, groups:read, groups:history,
# chat:write, channels:manage, groups:write (for private channel creation), users:read
# (search:read requires a user token, not bot)
SLACK_BOT_TOKEN=

# Gmail — email tools (OAuth2, not a simple API key)
# 1. console.cloud.google.com -> new/existing project -> enable "Gmail API"
# 2. OAuth consent screen -> External -> add yourself as a test user
# 3. Credentials -> Create OAuth client ID -> Application type: Desktop app
# 4. Use OAuth Playground (developers.google.com/oauthplayground) with your own
#    client_id/secret to authorize scopes: gmail.readonly, gmail.send, gmail.modify
#    and exchange for a refresh_token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
