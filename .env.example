# All tokens below are optional — filesystem, git, shell, Terraform, and Docker
# tools work with no configuration at all. Add only the ones for services you
# plan to use. See README.md and the docs site for setup details per service.

# GitHub — repo/issue/PR tools
# Create at: https://github.com/settings/tokens?type=beta
# Needs: Contents (read/write), Issues (read/write), Pull requests (read/write),
# Administration (read/write, only if you want github_create_repo / github_delete_repo)
GITHUB_TOKEN=

# Vercel — project/deployment tools
# Create at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Supabase — project/SQL tools
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Slack — channel/message tools
# Create a Slack app at: https://api.slack.com/apps -> OAuth & Permissions
# Bot token scopes needed: channels:read, channels:history, groups:read, groups:history,
# chat:write, channels:manage, groups:write (for private channel creation), users:read
# (search:read requires a user token, not bot)
SLACK_BOT_TOKEN=

# Gmail — email tools (OAuth2, not a simple API key)
# 1. console.cloud.google.com -> new/existing project -> enable "Gmail API"
# 2. OAuth consent screen -> External -> add yourself as a test user
# 3. Credentials -> Create OAuth client ID -> Application type: Desktop app
# 4. Use OAuth Playground (developers.google.com/oauthplayground) with your own
#    client_id/secret to authorize scopes: gmail.readonly, gmail.send, gmail.modify
#    and exchange for a refresh_token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Calendar — event/free-busy tools (same OAuth client as Gmail works)
# Enable "Google Calendar API" in the same Google Cloud project, then in OAuth
# Playground authorize scopes: calendar.events and calendar.readonly, and
# exchange for a refresh token. Client id/secret fall back to GMAIL_CLIENT_*.
# CALENDAR_CLIENT_ID=
# CALENDAR_CLIENT_SECRET=
CALENDAR_REFRESH_TOKEN=
# Optional IANA timezone for "today"/"tomorrow" and working hours (default: machine zone)
# CAUSLY_TIMEZONE=Asia/Kolkata

# Telegram — alerts and bot messages. No OAuth, just a bot token.
# 1. Message @BotFather -> /newbot -> copy the token
# 2. Send any message to your new bot, then call telegram_get_updates to see your chat id
TELEGRAM_BOT_TOKEN=
# Chat that telegram_notify writes to (your own chat id)
TELEGRAM_CHAT_ID=

# Linear — issue tools
# Create at: Linear > Settings > Account > Security & access > Personal API keys
LINEAR_API_KEY=

# Stripe — customers, invoices, payment links, refunds. START WITH TEST MODE.
# Create at: https://dashboard.stripe.com/test/apikeys (toggle "Test mode" on).
# A restricted key (rk_test_...) works too; give it only the permissions you need.
# Live keys (sk_live_/rk_live_) are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_API_KEY=
# STRIPE_ALLOW_LIVE=true
# Currency used when a tool call does not give one (default usd)
# STRIPE_DEFAULT_CURRENCY=inr

# Discord — read and post in your servers. Bot token only.
# 1. discord.com/developers/applications -> New Application -> Bot -> Reset Token
# 2. Bot page: turn on "Message Content Intent" (needed to read other people's text)
# 3. OAuth2 > URL Generator: scope "bot", permissions View Channels + Read Message History +
#    Send Messages; open the URL to invite the bot to your server
DISCORD_BOT_TOKEN=

# Groq - meeting transcription (Whisper). Free tier at https://console.groq.com/keys
# Audio is uploaded to Groq only when you confirm a meeting_transcribe call.
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Files above this size need ffmpeg on PATH to be compressed first (default 25)
# GROQ_MAX_FILE_MB=25

# Notion — page/database/block tools
# Create at: https://www.notion.so/my-integrations
# Also required: open each page/database in Notion you want accessible, click
# "..." -> Connections -> add your integration. The API only sees pages/databases
# explicitly shared with it, even with a valid token.
NOTION_API_KEY=

# Terraform — no token needed here. Just install the Terraform CLI and make
# sure `terraform` is on your PATH. These tools shell out to the CLI directly.

# Docker — no token needed here. Tries `docker` directly first (macOS/Linux/
# Docker Desktop), falls back to `wsl docker` on Windows if Docker only exists
# inside WSL.

# Postgres / MySQL — no persistent env var. Pass a connection string directly
# on each call, e.g. postgres://user:pass@host:5432/dbname or
# mysql://user:pass@host:3306/dbname

# Secrets manager — local encrypted secret storage, no external service.
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_MASTER_KEY=
# Only needed temporarily while rotating the master key (see docs) — remove
# once rotation is complete.
# SECRETS_MASTER_KEY_NEW=

# Sentry — error monitoring/issue tools
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# Needs at least project:read + event:read; add event:write for
# sentry_resolve_issue / sentry_ignore_issue / sentry_add_comment
SENTRY_AUTH_TOKEN=

# BoundaryAttest server receipt POC — optional and disabled by default.
# The private key must be an operator-controlled Ed25519 PKCS #8 PEM file
# outside the MCP client. No key or receipt directory is needed when disabled.
BOUNDARYATTEST_ENABLED=false
# BOUNDARYATTEST_PRIVATE_KEY=/absolute/path/to/ed25519-private.pem
# BOUNDARYATTEST_RECEIPT_DIR=/absolute/path/to/receipts
# Optional subset of the three POC tools (cannot expand beyond this set):
# BOUNDARYATTEST_TOOLS=ship_change,verify_ci_fix,deploy_project
