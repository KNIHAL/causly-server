{
  "name": "causly-server",
  "mcpName": "io.github.KNIHAL/causly-server",
  "version": "1.5.3",
  "description": "Open-source MCP server that turns any AI agent into your technical co-founder",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "setup": "node bin/causly.js init",
    "doctor": "node bin/causly.js doctor",
    "build:manifest": "node scripts/build-manifest.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build:manifest && vitest run",
    "test:boundaryattest": "vitest run tests/boundaryAttest.test.js",
    "verify:boundaryattest": "node tools/verifyBoundaryAttest.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  },
  "bin": {
    "causly-server": "bin/causly.js"
  },
  "files": [
    "index.js",
    "bin",
    "tools",
    "packs",
    "prompts",
    ".env.example",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "devops",
    "cofounder",
    "claude",
    "cursor",
    "windsurf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KNIHAL/causly-server.git"
  }
}
