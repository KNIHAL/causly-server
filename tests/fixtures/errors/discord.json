{
  "service": "discord",
  "secrets": [
    "discord-SECRET.TOKEN"
  ],
  "cases": {
    "401": {
      "response": {
        "status": 401,
        "body": {
          "message": "401: Unauthorized",
          "code": 0
        }
      },
      "match": "rejected the credentials \\(401\\).*causly-server setup discord"
    },
    "404": {
      "response": {
        "status": 404,
        "body": {
          "message": "Unknown Channel",
          "code": 10003
        }
      },
      "match": "Unknown Channel.*bot is in that server"
    },
    "429": {
      "response": {
        "status": 429,
        "headers": {
          "retry-after": "12"
        },
        "body": {
          "message": "You are being rate limited.",
          "retry_after": 11.2,
          "global": false
        }
      },
      "match": "rate limit reached \\(429\\). Try again in 12s"
    },
    "403_scope": {
      "response": {
        "status": 403,
        "body": {
          "message": "Missing Access",
          "code": 50001
        }
      },
      "match": "refused the request \\(403\\).*Missing Access.*Read Message History"
    },
    "403_rate_limit": {
      "response": {
        "status": 429,
        "headers": {
          "retry-after": "12"
        },
        "body": {
          "message": "You are being rate limited.",
          "retry_after": 11.2,
          "global": false
        }
      },
      "match": "rate limit reached.*Try again in 12s"
    },
    "5xx": {
      "response": {
        "status": 502,
        "rawBody": "<html><body><h1>502 Bad Gateway</h1></body></html>"
      },
      "match": "having problems \\(HTTP 502\\)"
    },
    "timeout": {
      "throws": "TimeoutError",
      "match": "did not answer within 20s"
    },
    "network": {
      "throws": "ECONNRESET",
      "match": "Could not reach Discord \\(ECONNRESET\\)"
    },
    "malformed_json": {
      "response": {
        "status": 200,
        "rawBody": "<html>maintenance</html>"
      },
      "match": "could not be read \\(HTTP 200, not valid JSON\\)"
    }
  }
}
