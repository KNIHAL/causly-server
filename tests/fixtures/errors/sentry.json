{
  "service": "sentry",
  "secrets": [
    "sntrys_SECRETTOKEN"
  ],
  "cases": {
    "401": {
      "response": {
        "status": 401,
        "body": {
          "detail": "Invalid token"
        }
      },
      "match": "rejected the credentials \\(401\\).*causly-server setup sentry"
    },
    "404": {
      "response": {
        "status": 404,
        "body": {
          "detail": "The requested resource does not exist"
        }
      },
      "match": "does not exist.*organization, project"
    },
    "429": {
      "response": {
        "status": 429,
        "headers": {
          "retry-after": "12"
        },
        "body": {
          "detail": "Request was throttled."
        }
      },
      "match": "rate limit reached \\(429\\). Try again in 12s"
    },
    "403_scope": {
      "response": {
        "status": 403,
        "body": {
          "detail": "You do not have permission to perform this action."
        }
      },
      "match": "refused the request \\(403\\).*do not have permission"
    },
    "403_rate_limit": {
      "response": {
        "status": 429,
        "headers": {
          "retry-after": "12"
        },
        "body": {
          "detail": "Request was throttled."
        }
      },
      "match": "rate limit reached.*Try again in 12s"
    },
    "5xx": {
      "response": {
        "status": 502,
        "rawBody": "<html><body><h1>502 Bad Gateway</h1></body></html>"
      },
      "match": "having problems \\(HTTP 502\\)"
    },
    "timeout": {
      "throws": "TimeoutError",
      "match": "did not answer within 20s"
    },
    "network": {
      "throws": "ECONNRESET",
      "match": "Could not reach Sentry \\(ECONNRESET\\)"
    },
    "malformed_json": {
      "response": {
        "status": 200,
        "rawBody": "<html>maintenance</html>"
      },
      "match": "could not be read \\(HTTP 200, not valid JSON\\)"
    }
  }
}
